name: configurable_baseline_model

uv_env: pyproject.toml

required_covariates: []

# Generated from config.ModelConfig with `uv run python dump_user_options.py`.
user_options:
  spread_factor:
    default: 1.0
    description: Multiplies the distance of each sample from the median in log(1 +
      cases) space. 1 keeps the seasonal shift persistence samples, 0 gives a point
      forecast at the median, below 1 narrows and above 1 widens the forecast.
    minimum: 0.0
    title: Spread Factor
    type: number
  log_bias:
    default: 0.0
    description: Added to every sample in log(1 + cases) space. 0.1 scales forecasts
      by about 1.1.
    title: Log Bias
    type: number

entry_points:
  train:
    parameters:
      train_data: path
      model: str
      model_config: str
    command: "python train.py {train_data} {model} {model_config}"
  predict:
    parameters:
      historic_data: path
      future_data: path
      model: str
      out_file: path
      model_config: str
    command: "python predict.py {model} {historic_data} {future_data} {out_file} {model_config}"

meta_data:
  display_name: "Seasonal shift persistence (configurable spread and bias)"
  description: "CHAP's seasonal shift persistence baseline, with the spread of the samples around the median scaled and a bias added in log(1 + cases) space. With the default options it gives the same samples as the built-in model."
  author: "Knut Rand"
