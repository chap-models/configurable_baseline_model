name: configurable_baseline_model

uv_env: pyproject.toml

required_covariates: []

# Generated from config.ModelConfig with `uv run python dump_user_options.py`.
user_options:
  method:
    default: seasonal_shift
    description: 'Point forecast in log space. ''persistence'': the last observed
      value. ''baseline'': the location''s mean for the period of year. ''seasonal_shift'':
      the last observed value shifted by the difference between the location''s means
      for the target and the last observed period of year.'
    enum:
    - seasonal_shift
    - persistence
    - baseline
    title: Method
    type: string
  log_bias:
    default: 0.0
    description: Added to every forecast in log(1 + cases) space. 0.1 scales forecasts
      by about 1.1.
    title: Log Bias
    type: number
  log_noise_sd:
    default: 0.0
    description: Standard deviation of the Gaussian noise added to each sample in
      log(1 + cases) space.
    minimum: 0.0
    title: Log Noise Sd
    type: number
  n_samples:
    default: 100
    description: Number of samples per forecast.
    maximum: 1000
    minimum: 1
    title: N Samples
    type: integer
  seed:
    default: 0
    description: Seed for the noise, for reproducible forecasts.
    title: Seed
    type: integer

entry_points:
  train:
    parameters:
      train_data: path
      model: str
      model_config: str
    command: "python train.py {train_data} {model} {model_config}"
  predict:
    parameters:
      historic_data: path
      future_data: path
      model: str
      out_file: path
      model_config: str
    command: "python predict.py {model} {historic_data} {future_data} {out_file} {model_config}"
